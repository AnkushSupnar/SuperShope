<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #EDE7F6;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ankush.controller.settings.AppSettingsController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="25.0" style="-fx-padding: 40;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Back Button and Header -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button fx:id="btnBack" style="-fx-background-color: rgba(57,73,171,0.1); -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 14;">
                     <graphic>
                        <FontAwesomeIcon fill="#3949AB" glyphName="ARROW_LEFT" size="1.3em" />
                     </graphic>
                  </Button>
                  <StackPane prefHeight="44.0" prefWidth="44.0" style="-fx-background-color: linear-gradient(to bottom right, #00796B, #004D40); -fx-background-radius: 12;">
                     <children>
                        <FontAwesomeIcon fill="WHITE" glyphName="COGS" size="1.5em" />
                     </children>
                  </StackPane>
                  <Label style="-fx-text-fill: #1A237E; -fx-font-size: 28px; -fx-font-weight: bold;" text="Application Settings">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Settings Section -->
            <VBox spacing="20.0" style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #E8EAF6); -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(26,35,126,0.12), 16, 0, 0, 6); -fx-padding: 35;">
               <children>
                  <!-- Stock Check Setting -->
                  <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F5F5F5; -fx-background-radius: 12; -fx-border-color: #C5CAE9; -fx-border-radius: 12; -fx-padding: 20;">
                     <children>
                        <StackPane prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: linear-gradient(to bottom right, #00796B, #004D40); -fx-background-radius: 12;">
                           <children>
                              <FontAwesomeIcon fill="WHITE" glyphName="CHECK_CIRCLE" size="1.5em" />
                           </children>
                        </StackPane>
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #1A237E; -fx-font-size: 16px; -fx-font-weight: bold;" text="Stock Check">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <Label style="-fx-text-fill: #616161; -fx-font-size: 13px;" text="When enabled, billing will strictly check item stock availability before adding items." wrapText="true">
                                 <font>
                                    <Font size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="toggleStockCheck" prefHeight="36.0" prefWidth="80.0" style="-fx-background-color: #BDBDBD; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="OFF">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </ToggleButton>
                     </children>
                  </HBox>

                  <!-- Status Label -->
                  <Label fx:id="lblStatus" style="-fx-text-fill: #00796B; -fx-font-size: 13px;" text="">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
