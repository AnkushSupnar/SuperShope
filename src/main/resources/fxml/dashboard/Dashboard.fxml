<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!-- The dashboard content is built by the controller (com.ankush.controller.dashboard.Dashboard) -->
<AnchorPane prefHeight="737.0" prefWidth="1156.0" styleClass="dash-root" stylesheets="@../css/dashboard-modern.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ankush.controller.dashboard.Dashboard">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #EDE7F6;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox fx:id="content" spacing="18.0" style="-fx-padding: 22 26 26 26;" styleClass="dash-root" />
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
